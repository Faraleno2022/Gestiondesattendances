# Copiez ce fichier sous le nom .env et remplissez les valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub.
# Sans MYSQL_DB, l'application utilise SQLite (data/attendance.db).

# --- MySQL (exemple pour PythonAnywhere) ---
MYSQL_DB=VOTRE_COMPTE$presences
MYSQL_USER=VOTRE_COMPTE
MYSQL_PASSWORD=mot_de_passe_mysql
MYSQL_HOST=VOTRE_COMPTE.mysql.pythonanywhere-services.com
MYSQL_PORT=3306

# --- Sécurité ---
# À activer une fois le site servi en HTTPS.
# HTTPS_ONLY=1
